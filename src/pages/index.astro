---
import App from '../components/App';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#153e35" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="App to mantenimiento: el concepto de marketplace que conecta tu hogar con profesionales, servicios y conocimiento en México." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>App to mantenimiento — Tu casa, en buenas manos.</title>
  </head>
  <body><App client:load /><noscript>Activa JavaScript para explorar este prototipo interactivo de App to mantenimiento.</noscript></body>
</html>
